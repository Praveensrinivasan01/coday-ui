{
  "manifest_version": 3,
  "name": "Cosday Chrome Extension",
  "version": "1.0",
  "permissions": ["storage","http://localhost:3000/*"],
  "host_permissions": ["http://localhost:3000/*"],
  "action": {
    "default_popup": "index.html"
  },
  "background": {
    "service_worker": "background.js"
  }
}
